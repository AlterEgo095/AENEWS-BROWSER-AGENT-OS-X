{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "forceExit": true,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": "<rootDir>/../tsconfig.json",
      "diagnostics": {
        "ignoreCodes": [2304, 2352, 2339, 2582, 2678, 2322, 2739, 2740, 2322, 2554]
      }
    }]
  },
  "testPathIgnorePatterns": [".e2e-spec.ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^../../src/(.*)$": "<rootDir>/../src/$1",
    "^../src/(.*)$": "<rootDir>/../src/$1"
  }
}
