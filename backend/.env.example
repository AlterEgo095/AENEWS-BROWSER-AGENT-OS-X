# ============================================================
# AENEWS AGENT OS X - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

APP_NAME=AENEWS-Agent-OS-X
APP_PORT=3000
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aenews_osx
DB_USER=aenews
DB_PASSWORD=CHANGE_ME
DB_SYNCHRONIZE=false
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aenews
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=aenews

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=aenews-storage

JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

ENCRYPTION_KEY=CHANGE_ME_32_CHARS_EXACTLY!

LOG_LEVEL=info
LOG_FORMAT=json

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

AGENT_MAX_CONCURRENT=50
AGENT_TIMEOUT=300000
AGENT_RETRY_MAX=3
AGENT_RETRY_DELAY=5000

PLUGIN_DIR=./plugins
PLUGIN_AUTOLOAD=true

TENANT_ISOLATION=strict
TENANT_DEFAULT_QUOTA_AGENTS=100
TENANT_DEFAULT_QUOTA_TASKS=10000

SENTRY_DSN=
PROMETHEUS_PORT=9090
