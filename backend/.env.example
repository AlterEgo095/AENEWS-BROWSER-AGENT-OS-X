# ============================================================
# AENEWS AGENT OS X — Backend Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set — the app will not
# start without them. All other variables have sensible
# defaults for local development.
#
# NEVER commit real secrets to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME=AENEWS-Agent-OS-X
APP_PORT=3000
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=api/v1

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aenews_osx
DB_USER=aenews
# [REQUIRED] Set a strong password in production.
DB_PASSWORD=
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Connection pool settings
DB_POOL_SIZE=20
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for no password (default in local dev)
REDIS_PASSWORD=
REDIS_DB=0

# ─── Neo4j (Knowledge Graph) ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# [REQUIRED] Set a strong password in production.
NEO4J_PASSWORD=

# ─── Qdrant (Vector Search) ────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── RabbitMQ (Message Broker) ─────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aenews
# [REQUIRED] Set a strong password in production.
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=aenews

# ─── MinIO (S3-Compatible Object Storage) ──────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# [REQUIRED] Access key (matches MINIO_ROOT_USER in docker-compose)
MINIO_ACCESS_KEY=
# [REQUIRED] Secret key (matches MINIO_ROOT_PASSWORD in docker-compose)
MINIO_SECRET_KEY=
MINIO_BUCKET=aenews-storage

# ─── JWT Authentication ────────────────────────────────────
# [REQUIRED] Must be a cryptographically random string in production.
#   Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption ─────────────────────────────────────────────
# [REQUIRED] Must be exactly 32 characters long.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
ENCRYPTION_KEY=

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# In development, localhost origins are auto-allowed.
# Example: CORS_ORIGINS=https://app.aenews.ai,https://admin.aenews.ai
CORS_ORIGINS=
SECURITY_CORS_ORIGINS=

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Rate Limiting ──────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Agent Configuration ───────────────────────────────────
AGENT_MAX_CONCURRENT=50
AGENT_TIMEOUT=300000
AGENT_RETRY_MAX=3
AGENT_RETRY_DELAY=5000

# ─── Plugin System ──────────────────────────────────────────
PLUGIN_DIR=./plugins
PLUGIN_AUTOLOAD=false

# ─── Multi-Tenancy ──────────────────────────────────────────
TENANT_ISOLATION=strict
TENANT_DEFAULT_QUOTA_AGENTS=100
TENANT_DEFAULT_QUOTA_TASKS=10000

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ─── LLM Provider ──────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
# [REQUIRED] Set your OpenAI API key to enable LLM features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
# [REQUIRED] Set your Anthropic API key to enable fallback LLM features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
LLM_FALLBACK_ENABLED=false
LLM_SECONDARY_PROVIDER=anthropic
# LLM Cache configuration
LLM_CACHE_TTL_MS=300000
LLM_CACHE_MAX_SIZE=1000
# Dead host cooldown
DEAD_HOST_COOLDOWN_MS=20000

# ─── Observability ──────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_PROMETHEUS_PORT=9464
METRICS_ENABLED=true

# ─── Office Connector ───────────────────────────────────────
OFFICE_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aenews.io

# ─── Infrastructure Connector ───────────────────────────────
INFRA_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock

# ─── Security Connector ─────────────────────────────────────
SECURITY_ENABLED=true
SECURITY_ENCRYPTION_KEY=

# ─── Performance ────────────────────────────────────────────
PERF_SLOW_QUERY_ENABLED=true
PERF_SLOW_QUERY_THRESHOLD_MS=500
PERF_SLOW_QUERY_MAX_ENTRIES=1000
PERF_RESPONSE_CACHE_ENABLED=true
PERF_RESPONSE_CACHE_TTL=30
PERF_RESPONSE_CACHE_MAX_SIZE=5000
PERF_COMPRESSION_ENABLED=true
PERF_COMPRESSION_THRESHOLD=1024
PERF_COMPRESSION_LEVEL=6
PERF_PROFILING_ENABLED=true
PERF_PROFILING_INTERVAL_MS=10000
PERF_POOL_MONITORING_ENABLED=true
PERF_HTTP_POOL_MAX=50
