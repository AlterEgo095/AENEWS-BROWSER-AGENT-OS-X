# ============================================================
# AENEWS AGENT OS X — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set — the app will not
# start without them. All other variables have sensible
# defaults for local development.
#
# NEVER commit real secrets to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
# Application identity and runtime settings.
APP_NAME=AENEWS-Agent-OS-X
APP_PORT=3000
# Valid values: development | staging | production
APP_ENV=development
APP_VERSION=0.1.0
# API route prefix — all endpoints are served under this path
API_PREFIX=api/v1

# ─── PostgreSQL ──────────────────────────────────────────────
# Primary relational database. Started via docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aenews_osx
DB_USER=aenews
# [REQUIRED] Set a strong, unique password. Do NOT use default in production.
DB_PASSWORD=
# Also used by docker-compose as POSTGRES_PASSWORD
POSTGRES_PASSWORD=
POSTGRES_DB=aenews_osx
POSTGRES_USER=aenews
# Auto-sync TypeORM entities (use only in dev; migrations in prod)
DB_SYNCHRONIZE=false
# Enable SQL query logging (verbose — use only for debugging)
DB_LOGGING=false

# ─── Redis ──────────────────────────────────────────────────
# Used for caching, BullMQ job queues, and session storage.
REDIS_HOST=localhost
REDIS_PORT=6379
# [REQUIRED] Set a strong password. Dev fallback: dev_redis_2024
REDIS_PASSWORD=
# Redis database index (0–15)
REDIS_DB=0

# ─── Neo4j (Knowledge Graph) ───────────────────────────────
# Graph database for agent relationships and knowledge graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# [REQUIRED] Set a strong, unique password.
NEO4J_PASSWORD=

# ─── Qdrant (Vector Search) ────────────────────────────────
# Vector database for similarity search and RAG pipelines.
QDRANT_HOST=localhost
QDRANT_PORT=6333
# API key for authenticated Qdrant instances (leave empty for local)
QDRANT_API_KEY=

# ─── RabbitMQ (Message Broker) ─────────────────────────────
# Event-driven messaging between agents and services.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aenews
# [REQUIRED] Set a strong, unique password.
RABBITMQ_PASSWORD=
# Virtual host for tenant isolation
RABBITMQ_VHOST=aenews

# ─── MinIO (S3-Compatible Object Storage) ──────────────────
# Stores agent artifacts, logs, models, configs, and uploads.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# [REQUIRED] Access key (matches MINIO_ROOT_USER in docker-compose)
MINIO_ACCESS_KEY=
# [REQUIRED] Secret key (matches MINIO_ROOT_PASSWORD in docker-compose)
MINIO_SECRET_KEY=
# Default bucket for general storage
MINIO_BUCKET=aenews-storage

# ─── JWT Authentication ────────────────────────────────────
# JSON Web Token configuration for API authentication.
# [REQUIRED] Must be a cryptographically random string.
#   Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Access token expiration
JWT_EXPIRATION=24h
# Refresh token expiration
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption ─────────────────────────────────────────────
# AES-256 encryption key for sensitive data at rest.
# [REQUIRED] Must be exactly 32 characters long.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
ENCRYPTION_KEY=

# ─── Grafana (Monitoring) ──────────────────────────────────
# Grafana admin credentials for the monitoring stack.
GRAFANA_ADMIN_USER=admin
# [REQUIRED] Set a strong password for Grafana admin.
GRAFANA_ADMIN_PASSWORD=
# Grafana external URL (used in alert links)
GRAFANA_ROOT_URL=http://localhost:3002

# ─── Logging ────────────────────────────────────────────────
# Valid levels: debug | info | warn | error
LOG_LEVEL=info
# Valid formats: json | text (use text for local dev readability)
LOG_FORMAT=json

# ─── Rate Limiting ──────────────────────────────────────────
# Throttler guard applied globally to all API endpoints.
# Time window in milliseconds
THROTTLE_TTL=60000
# Max requests per window per IP
THROTTLE_LIMIT=100

# ─── Agent Configuration ───────────────────────────────────
# Maximum number of agents running simultaneously
AGENT_MAX_CONCURRENT=50
# Agent execution timeout in milliseconds (5 minutes default)
AGENT_TIMEOUT=300000
# Maximum retry attempts for failed agent executions
AGENT_RETRY_MAX=3
# Delay between retries in milliseconds
AGENT_RETRY_DELAY=5000

# ─── Plugin System ──────────────────────────────────────────
# Directory containing plugin modules
PLUGIN_DIR=./plugins
# Automatically load plugins on startup
PLUGIN_AUTOLOAD=false

# ─── Multi-Tenancy ──────────────────────────────────────────
# Isolation mode: strict (full isolation) | relaxed (shared resources)
TENANT_ISOLATION=strict
# Default quota: max agents per tenant
TENANT_DEFAULT_QUOTA_AGENTS=100
# Default quota: max tasks per tenant
TENANT_DEFAULT_QUOTA_TASKS=10000

# ─── Monitoring ─────────────────────────────────────────────
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
# Prometheus metrics server port
PROMETHEUS_PORT=9090

# ─── LLM Provider ──────────────────────────────────────────
# Default LLM provider: openai | anthropic
LLM_DEFAULT_PROVIDER=openai
# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
# Anthropic configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
# Fallback: if primary provider fails, try secondary
LLM_FALLBACK_ENABLED=false
LLM_SECONDARY_PROVIDER=anthropic
