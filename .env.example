# ─── AENEWS Agent OS X — Environment Configuration ───────────────
# Copy this file to .env and update values for your environment.
# All values shown are defaults for local development.

# ─── Application ──────────────────────────────────────────────────
APP_NAME=AENEWS-Agent-OS-X
APP_PORT=3000
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=api/v1

# ─── PostgreSQL ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aenews_osx
DB_USER=aenews
DB_PASSWORD=changeme
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Neo4j (Knowledge Graph) ─────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Qdrant (Vector Search) ──────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aenews
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=aenews

# ─── MinIO (Object Storage) ──────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aenews-storage

# ─── JWT Authentication ──────────────────────────────────────────
JWT_SECRET=changeme-to-a-secure-random-string
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption ──────────────────────────────────────────────────
ENCRYPTION_KEY=changeme-to-a-32-char-key!!!!

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Rate Limiting ───────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Agent Configuration ─────────────────────────────────────────
AGENT_MAX_CONCURRENT=50
AGENT_TIMEOUT=300000
AGENT_RETRY_MAX=3
AGENT_RETRY_DELAY=5000

# ─── Plugin System ───────────────────────────────────────────────
PLUGIN_DIR=./plugins
PLUGIN_AUTOLOAD=false

# ─── Multi-Tenancy ───────────────────────────────────────────────
TENANT_ISOLATION=strict
TENANT_DEFAULT_QUOTA_AGENTS=100
TENANT_DEFAULT_QUOTA_TASKS=10000

# ─── Monitoring ──────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_PORT=9090
