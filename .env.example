# ─── Application ────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_NAME=AENEWS-Agent-OS-X
APP_VERSION=0.0.1
APP_DESCRIPTION="AENEWS Agent OS X - Enterprise Autonomous Browser Platform"

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aenews
POSTGRES_USER=aenews
POSTGRES_PASSWORD=aenews_secret
POSTGRES_SYNCHRONIZE=true
POSTGRES_LOGGING=true
POSTGRES_POOL_SIZE=20

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=aenews_redis_secret
REDIS_DB=0

# ─── Bull Queue (uses Redis) ──────────────────────────────────
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=aenews_redis_secret
BULL_REDIS_DB=1

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=aenews
RABBITMQ_PASSWORD=aenews_rabbitmq_secret
RABBITMQ_VHOST=aenews
RABBITMQ_MGMT_PORT=15672

# ─── Neo4j ─────────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aenews_neo4j_secret
NEO4J_DATABASE=neo4j

# ─── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aenews_embeddings

# ─── MinIO ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=aenews_minio
MINIO_SECRET_KEY=aenews_minio_secret
MINIO_BUCKET=aenews-storage
MINIO_USE_SSL=false

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ─── Swagger / API Docs ───────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=AENEWS Agent OS X API
SWAGGER_DESCRIPTION=Enterprise Autonomous Browser Platform API
SWAGGER_VERSION=0.0.1
SWAGGER_PATH=api/docs

# ─── CORS ─────────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIR=logs

# ─── Playwright ───────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWROWSER_TIMEOUT=30000
PLAYWRIGHT_MAX_BROWSERS=5
PLAYWRIGHT_MAX_PAGES_PER_BROWSER=10

# ─── OpenTelemetry ────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aenews-agent-os-x
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

# ─── Agent Configuration ─────────────────────────────────────
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TASK_TIMEOUT_MS=300000
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY_MS=1000

# ─── Cluster Configuration ────────────────────────────────────
CLUSTER_NODE_ID=node-01
CLUSTER_NODE_TYPE=worker
CLUSTER_HEARTBEAT_INTERVAL_MS=5000
CLUSTER_ELECTION_TIMEOUT_MS=10000
