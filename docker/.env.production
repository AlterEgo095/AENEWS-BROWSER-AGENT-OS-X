# ============================================================
# AENEWS AGENT OS X — Production Environment Template
# ============================================================
# Copy this file to .env and fill in your production values.
#   cp .env.production .env
#
# ⚠️  NEVER commit real secrets to version control.
# ⚠️  All [REQUIRED] fields must be set before deployment.
#
# Quick secret generation:
#   JWT_SECRET:          openssl rand -hex 64
#   ENCRYPTION_KEY:      openssl rand -hex 16  (must be 32 chars)
#   DB_PASSWORD:         openssl rand -hex 32
#   REDIS_PASSWORD:      openssl rand -hex 32
#   NEO4J_PASSWORD:      openssl rand -hex 32
#   RABBITMQ_PASSWORD:   openssl rand -hex 32
#   MINIO_SECRET_KEY:    openssl rand -hex 32
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME=AENEWS-Agent-OS-X
APP_PORT=3000
APP_ENV=production
APP_VERSION=1.0.0
API_PREFIX=api/v1

# ─── Domain ──────────────────────────────────────────────────
# Your public domain (used for CORS, SSL, etc.)
APP_DOMAIN=your-domain.com
APP_URL=https://your-domain.com

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aenews_osx
DB_USER=aenews
# [REQUIRED] Strong password — generate with: openssl rand -hex 32
DB_PASSWORD=REPLACE_ME_DB_PASSWORD
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# [REQUIRED] Strong password — generate with: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
REDIS_DB=0

# ─── Neo4j (Knowledge Graph) ───────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# [REQUIRED] Strong password — generate with: openssl rand -hex 32
NEO4J_PASSWORD=REPLACE_ME_NEO4J_PASSWORD

# ─── Qdrant (Vector Search) ────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── RabbitMQ (Message Broker) ─────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=aenews
# [REQUIRED] Strong password — generate with: openssl rand -hex 32
RABBITMQ_PASSWORD=REPLACE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=aenews

# ─── MinIO (S3-Compatible Object Storage) ──────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# [REQUIRED] Generate with: openssl rand -hex 16
MINIO_ACCESS_KEY=REPLACE_ME_MINIO_ACCESS_KEY
# [REQUIRED] Generate with: openssl rand -hex 32
MINIO_SECRET_KEY=REPLACE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=aenews-storage

# ─── JWT Authentication ────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_ME_JWT_SECRET
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption ─────────────────────────────────────────────
# [REQUIRED] Must be exactly 32 characters
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=REPLACE_ME_32_CHAR_ENCRYPTION_KEY

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_FORMAT=json

# ─── Rate Limiting ──────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Agent Configuration ───────────────────────────────────
AGENT_MAX_CONCURRENT=30
AGENT_TIMEOUT=300000
AGENT_RETRY_MAX=3
AGENT_RETRY_DELAY=5000

# ─── Plugin System ──────────────────────────────────────────
PLUGIN_DIR=./plugins
PLUGIN_AUTOLOAD=false

# ─── Multi-Tenancy ──────────────────────────────────────────
TENANT_ISOLATION=strict
TENANT_DEFAULT_QUOTA_AGENTS=100
TENANT_DEFAULT_QUOTA_TASKS=10000

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ─── LLM Provider ──────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
# [REQUIRED] Your OpenAI API key
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
# [REQUIRED for fallback] Your Anthropic API key
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
LLM_FALLBACK_ENABLED=true
LLM_SECONDARY_PROVIDER=anthropic

# ─── Observability ──────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_PROMETHEUS_PORT=9464
METRICS_ENABLED=true

# ─── Office Connector ───────────────────────────────────────
OFFICE_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# ─── Infrastructure Connector ───────────────────────────────
INFRA_ENABLED=true
DOCKER_SOCKET=/var/run/docker.sock

# ─── Security Connector ─────────────────────────────────────
SECURITY_ENABLED=true
SECURITY_ENCRYPTION_KEY=

# ─── Docker Compose Service Passwords ──────────────────────
# These are used by docker-compose.prod.yml for service containers
POSTGRES_DB=aenews_osx
POSTGRES_USER=aenews
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD

# ─── Nginx ──────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─── Security (Phase 12) ────────────────────────────────────
# CORS — comma-separated list of allowed origins
SECURITY_CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# Account Lockout
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_BASE_DURATION_MIN=15
SECURITY_LOCKOUT_MAX_DURATION_MIN=1440
SECURITY_LOCKOUT_MULTIPLIER=2
SECURITY_LOCKOUT_RESET_AFTER_MIN=30
SECURITY_LOCKOUT_PROGRESSIVE_DELAY=true

# Refresh Token
SECURITY_REFRESH_TOKEN_MAX_FAMILIES=5
SECURITY_REFRESH_TOKEN_REUSE_WINDOW_MIN=5

# IP Access Control
SECURITY_IP_ADMIN_WHITELIST=
SECURITY_IP_METRICS_WHITELIST=
SECURITY_IP_INTERNAL_WHITELIST=
SECURITY_IP_PRIVATE_BYPASS=true

# Audit Log
SECURITY_AUDIT_BATCH_SIZE=50
SECURITY_AUDIT_FLUSH_INTERVAL_SEC=10
SECURITY_AUDIT_RETENTION_DAYS=90

# Threat Intelligence
SECURITY_THREAT_AUTO_BLOCK_SCORE=80
SECURITY_THREAT_BRUTE_FORCE_THRESHOLD=10
SECURITY_THREAT_SCANNING_THRESHOLD=20
SECURITY_THREAT_RATE_ABUSE_THRESHOLD=5
SECURITY_THREAT_TRACKING_WINDOW_MIN=15

# WebSocket Security
SECURITY_WS_MAX_CONNECTIONS_PER_IP=5
SECURITY_WS_RATE_LIMIT_PER_MIN=60
SECURITY_WS_SANITIZE_EVENTS=true

# Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_ENABLE_DEV=false

# Alerting
SLACK_WEBHOOK_URL=

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_WS_URL=wss://your-domain.com/socket.io
