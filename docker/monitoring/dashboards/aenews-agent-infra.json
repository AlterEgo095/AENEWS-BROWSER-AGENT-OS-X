{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AENEWS Agent OS X — Agent Execution Metrics and Infrastructure Health",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Agent Execution Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "Number of agents registered per cluster",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Agents by Cluster",
      "type": "barchart",
      "targets": [
        {
          "expr": "aenews_agent_registry_size",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "Agent execution duration P95 per cluster",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Agent Execution Duration (P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aenews_agent_execution_duration_seconds_bucket[5m])) by (le, cluster))",
          "legendFormat": "{{cluster}} P95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "Agent success vs failure rate",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Agent Success / Failure Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aenews_agent_execution_duration_seconds_count{result=\"success\"}[5m]))",
          "legendFormat": "Success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aenews_agent_execution_failures_total[5m]))",
          "legendFormat": "Failure",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "panels": [],
      "title": "Infrastructure Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "Connection pool utilization across services",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "title": "Connection Pool Utilization",
      "type": "timeseries",
      "targets": [
        {
          "expr": "aenews_pool_active_connections / aenews_pool_active_connections * 100",
          "legendFormat": "{{pool}} active",
          "refId": "A"
        },
        {
          "expr": "aenews_pool_active_connections",
          "legendFormat": "{{pool}} active",
          "refId": "B"
        },
        {
          "expr": "aenews_pool_idle_connections",
          "legendFormat": "{{pool}} idle",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "Process memory usage (RSS) per service",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "title": "Process Memory (RSS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 8,
      "panels": [],
      "title": "LLM Provider Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "LLM cache hit rate over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 9,
      "title": "LLM Cache Hit Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(aenews_llm_cache_hits_total[5m]) / rate(aenews_llm_cache_requests_total[5m])",
          "legendFormat": "Cache Hit Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-aenews" },
      "description": "Circuit breaker state per service",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" }, "1": { "text": "OPEN", "color": "red" }, "0.5": { "text": "HALF_OPEN", "color": "yellow" } } }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 10,
      "title": "Circuit Breaker States",
      "type": "stat",
      "targets": [
        {
          "expr": "aenews_security_circuit_breaker_state",
          "legendFormat": "{{circuit}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aenews", "agents", "infrastructure"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "AENEWS — Agent & Infrastructure",
  "uid": "aenews-agent-infra",
  "version": 1
}
